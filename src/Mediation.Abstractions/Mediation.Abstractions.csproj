<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Olbrasoft.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>Olbrasoft.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<Product>Olbrasoft.Mediation</Product>
		<PackageIcon>mediation.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/Olbrasoft/Mediation</PackageProjectUrl>
		<Copyright>© Olbrasoft 2025</Copyright>
		<Company>Olbrasoft</Company>
		<Version>10.0.0</Version>
		<Description>Core abstractions for the Mediation library - lightweight mediator pattern interfaces for .NET 6, 7, 8, 9, 10 and .NET Standard 2.1</Description>
		<Title>Mediation Abstractions</Title>
		<PackageTags>Mediator;CQRS;Abstractions;Interfaces;NET10</PackageTags>
		<PackageReleaseNotes>Version 10.0.0: Full support for .NET 10, aligned version with .NET 10 for clear compatibility. No breaking changes - seamless upgrade from 9.0.1.</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\..\mediation.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
